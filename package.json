{
  "name": "matchpoint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:open": "cap open android",
    "mobile:build:android": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "preview": "vite preview",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "verify:mvp": "node scripts/verify-mvp.mjs",
    "verify:achievements": "node scripts/verify-achievements.mjs",
    "verify:honor": "node scripts/verify-honor.mjs",
    "verify:lifecycle": "node scripts/verify-lifecycle-hardening.mjs",
    "verify:acceptance": "node scripts/verify-match-acceptance.mjs",
    "verify:sanctions": "node scripts/verify-sanctions.mjs",
    "verify:gameplay": "node scripts/verify-gameplay-progression.mjs",
    "verify:backend": "npm run verify:mvp && npm run verify:achievements && npm run verify:honor && npm run verify:lifecycle && npm run verify:acceptance && npm run verify:sanctions && npm run verify:gameplay"
  },
  "dependencies": {
    "@capacitor/android": "7.6.8",
    "@capacitor/app": "7.1.2",
    "@capacitor/browser": "7.0.5",
    "@capacitor/core": "7.6.8",
    "@capacitor/geolocation": "7.1.8",
    "@capacitor/keyboard": "7.0.6",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "@supabase/supabase-js": "2.100.0",
    "maplibre-gl": "5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "three": "^0.185.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.2",
    "supabase": "^2.111.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
