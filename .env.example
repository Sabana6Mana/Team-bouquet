# 네이버 클라우드 플랫폼 > Maps > Application 에서 발급받은 Client ID (Key ID)
#
# ※ Client Secret은 절대 넣지 마세요. 프론트엔드 값은 브라우저에 그대로 노출됩니다.
#    Client ID는 공개되어도 되는 값이며, 콘솔에 등록한 Web 서비스 URL로 사용이 제한됩니다.
#
# 이 파일은 템플릿입니다. 실제로 쓰려면 .env 라는 이름으로 복사해서 값을 채우세요.
# 값이 없으면 앱은 자동으로 내장 스타일 맵(폴백)으로 동작합니다.
VITE_NAVER_MAP_KEY_ID=

# 메인 지도 엔진: maplibre(게임형 3D 지도) 또는 naver(기존 지도)
# MapLibre가 실패하면 네이버 지도, 네이버 키가 없으면 내장 지도로 자동 전환됩니다.
VITE_MAP_ENGINE=maplibre
# 비워두면 OpenFreeMap bright 스타일을 사용합니다.
VITE_MAP_STYLE_URL=

# Supabase를 설정하면 실제 사용자 백엔드 모드로 동작합니다.
# 둘 다 비워 두면 기존 NPC 데모 모드를 유지합니다.
# Dashboard > Project Settings > API에서 URL과 Publishable key를 복사하세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase/Kakao 양쪽 설정을 끝낸 뒤에만 true로 바꾸세요.
# false이면 준비되지 않은 OAuth 버튼을 비활성화해 사용자에게 오류 화면을 보여주지 않습니다.
VITE_KAKAO_LOGIN_ENABLED=false

# 로컬 Supabase에서 카카오 OAuth를 켤 때만 사용합니다.
# Client Secret에 VITE_ 접두사를 붙이면 브라우저에 노출되므로 절대 붙이지 마세요.
# 값을 채운 뒤 docs/BACKEND_MVP.md 안내대로 config.toml의 Kakao 블록을 활성화하세요.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=
