# 네이버 클라우드 플랫폼 > Maps > Application 에서 발급받은 Client ID (Key ID)
#
# ※ Client Secret은 절대 넣지 마세요. 프론트엔드 값은 브라우저에 그대로 노출됩니다.
#    Client ID는 공개되어도 되는 값이며, 콘솔에 등록한 Web 서비스 URL로 사용이 제한됩니다.
#
# 이 파일은 템플릿입니다. 실제로 쓰려면 .env 라는 이름으로 복사해서 값을 채우세요.
# 값이 없으면 앱은 자동으로 내장 스타일 맵(폴백)으로 동작합니다.
VITE_NAVER_MAP_KEY_ID=

# Supabase를 설정하면 실제 사용자 백엔드 모드로 동작합니다.
# 둘 다 비워 두면 기존 NPC 데모 모드를 유지합니다.
# Dashboard > Project Settings > API에서 URL과 Publishable key를 복사하세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
